# Telegram: Bot bei @BotFather anlegen (/newbot) -> Token. Jeder Benutzer verbindet sich danach selbst
# im Tab «Meine» → «Telegram verbinden» (auch du – dort «Neue Konzerte: Alle» wählen). Leer = Telegram aus.
TELEGRAM_USER_BOT_TOKEN=

# Nur für den optionalen festen Chat (notifiers in config.yaml, standardmässig aus). Derselbe Token geht.
# Chat-ID: dem Bot eine Nachricht schicken, dann https://api.telegram.org/bot<TOKEN>/getUpdates öffnen.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Adresse der Weboberfläche im Heimnetz (wird in Telegram-Nachrichten verlinkt)
KONZERT_BASE_URL=http://homelab.local:8080
